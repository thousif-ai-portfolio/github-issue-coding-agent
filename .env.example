# Copy to .env and change what you need. Every setting is in agent/config.py.

# Any Ollama model. 7B writes better patches but needs about 8 GB of free RAM.
AGENT_LLM_MODEL=qwen2.5-coder:3b
AGENT_OLLAMA_HOST=http://localhost:11434

# Optional for public repos (GitHub then allows 60 requests an hour).
# To open draft PRs: a fine-grained token for one repository with read access to issues
# and read/write access to contents and pull requests.
AGENT_GITHUB_TOKEN=
